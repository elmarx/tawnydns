export RUST_LOG=info,tawnydns=debug

# tawnydns configuration
export PDNS_API_KEY=secret
export PUBLIC_KEY_FILE="tawnydns.pub"

# settings for tofu/pdns-provider
# 8082 for the service, 4001 for mitmproxy
export PDNS_SERVER_URL=http://localhost:8082
if [ -e "tawnydns.key" ]; then
  export TF_VAR_tenant_api_key=$(cat example.com.jwt)
fi
